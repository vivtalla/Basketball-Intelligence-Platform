# Sprint 82d — public mode. No auth gate; the API is fully open.
# Cloudflare WAF (free tier) handles rate limiting and bot mitigation.
# api.courtvue.app should be ORANGE-CLOUD (proxied) at Cloudflare so the WAF
# rules apply and the origin IP stays hidden.
api.courtvue.app {
    # Trust Cloudflare's CF-Connecting-IP header for real client IP in logs.
    # Backend reads this via X-Real-IP for rate-limit attribution.
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Structured JSON logs, rotate at 50 MB, keep 5.
    log {
        output file /var/log/caddy/bip-api.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}
